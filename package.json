{
  "name": "@olympusdao/treasury-subgraph",
  "version": "0.1.1",
  "private": true,
  "description": "Subgraphs for the Olympus treasury",
  "repository": "https://github.com/OlympusDAO/olympus-protocol-metrics-subgraph",
  "author": {
    "name": "Jem",
    "email": "0x0xjem@gmail.com",
    "url": "https://github.com/0xJem"
  },
  "type": "module",
  "scripts": {
    "apply:railway": "railway config apply --plan railway-plan.json --environment",
    "benchmark:rpc": "node scripts/benchmark-rpc.mjs",
    "build": "pnpm build:client && pnpm build:metrics-api && pnpm build:metrics-publisher && pnpm build:indexer-monitor",
    "build:client": "pnpm --dir apps/client build",
    "build:docker:hasura": "docker build -f Dockerfile-hasura -t olympus-protocol-metrics/hasura:local .",
    "build:docker:indexer": "docker build -f Dockerfile-indexer -t olympus-protocol-metrics/indexer:local .",
    "build:docker:indexer-monitor": "docker build -f Dockerfile-indexer-monitor -t olympus-protocol-metrics/indexer-monitor:local .",
    "build:docker:metrics-api": "docker build -f Dockerfile-metrics-api -t olympus-protocol-metrics/metrics-api:local .",
    "build:docker:metrics-publisher": "docker build -f Dockerfile-metrics-publisher -t olympus-protocol-metrics/metrics-publisher:local .",
    "build:docker:rpc-cache": "docker build -f Dockerfile-rpc-cache -t localhost/olympus-metrics-rpc-cache:local .",
    "build:indexer-monitor": "pnpm --dir apps/indexer-monitor build",
    "build:metrics-api": "pnpm --dir apps/metrics-api build",
    "build:metrics-publisher": "pnpm --dir apps/metrics-publisher build",
    "check": "biome check . && pnpm run lint:actions",
    "check:compose": "docker compose config",
    "check:runtime-versions": "node scripts/check-runtime-versions.mjs",
    "clear:compose:bucket": "docker compose run --rm --no-deps --entrypoint /bin/sh minio-init -c 'mc alias set local http://minio:9000 \"$MINIO_ROOT_USER\" \"$MINIO_ROOT_PASSWORD\" && mc rm --recursive --force \"local/${ARTIFACT_BUCKET:-metrics}\" && mc mb -p \"local/${ARTIFACT_BUCKET:-metrics}\"'",
    "codegen": "pnpm --dir apps/indexer codegen",
    "dev:indexer": "pnpm --dir apps/indexer dev",
    "lint": "biome check --write . && pnpm run lint:actions",
    "lint:actions": "mise exec --locked jactionlint -- jactionlint --profile correctness --no-online && mise exec --locked zizmor -- zizmor --offline --strict-collection --persona auditor --min-severity medium --min-confidence low --collect=workflows --collect=actions .github",
    "plan:railway": "railway config plan --out railway-plan.json",
    "plan:railway:bootstrap": "METRICS_RAILWAY_CACHE_BOOTSTRAP=1 railway config plan --out railway-plan.json",
    "publish:compose": "INDEXER_DEPLOYMENT_ID=$(git rev-parse HEAD) docker compose --profile publish run --build --rm --no-deps metrics-publisher",
    "scan:docker": "mise exec -- trivy image --image-config-scanners secret --severity MEDIUM,HIGH,CRITICAL --exit-code 1",
    "scan:docker:provider": "node scripts/validate.mjs provider",
    "start:indexer": "pnpm --dir apps/indexer start",
    "test": "pnpm test:root && pnpm test:artifacts && pnpm test:client && pnpm test:metrics-api && pnpm test:metrics-publisher && pnpm test:indexer && pnpm test:indexer-monitor",
    "test:artifacts": "vitest run packages/metrics-artifacts/tests",
    "test:client": "pnpm --dir apps/client test",
    "test:indexer": "pnpm --dir apps/indexer test",
    "test:indexer-monitor": "pnpm --dir apps/indexer-monitor test",
    "test:integration": "node scripts/validate.mjs integration",
    "test:metrics-api": "pnpm --dir apps/metrics-api test",
    "test:metrics-publisher": "pnpm --dir apps/metrics-publisher test",
    "test:root": "vitest run --dir tests --exclude '**/integration/**'",
    "test:rpc-cache": "node --test services/rpc-cache/integration.test.mjs",
    "typecheck": "tsc --noEmit && pnpm typecheck:indexer-monitor",
    "typecheck:indexer-monitor": "pnpm --dir apps/indexer-monitor typecheck",
    "up:compose": "docker compose up --build postgres hasura minio minio-init indexer metrics-api",
    "up:compose:api": "docker compose up --build minio minio-init metrics-api",
    "up:compose:api:rebuild": "docker compose up --build --no-deps metrics-api",
    "up:compose:core": "docker compose up postgres hasura indexer",
    "validate": "node scripts/validate.mjs source",
    "validate:all": "node scripts/validate.mjs all",
    "validate:images": "node scripts/validate.mjs images"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "railway": "3.16.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": "use-pnpm",
    "pnpm": ">=11.28.13 <12",
    "yarn": "use-pnpm"
  }
}
