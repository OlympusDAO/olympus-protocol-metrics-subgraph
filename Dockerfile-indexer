FROM node:24.22.3-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS base

ENV CI=true
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/corepack
ENV PATH=/pnpm:$PATH

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends --only-upgrade apt libapt-pkg6.0 libgcrypt20 libgnutls30 libpcre2-8-0 perl-base \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS build
RUN mkdir -p /corepack /pnpm && corepack enable && corepack prepare pnpm@11.28.13 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/indexer/package.json apps/indexer/package.json
COPY apps/metrics-api/package.json apps/metrics-api/package.json
COPY apps/metrics-publisher/package.json apps/metrics-publisher/package.json
COPY apps/client/package.json apps/client/package.json
RUN pnpm install --frozen-lockfile --filter @olympusdao/treasury-subgraph --filter @olympusdao/treasury-subgraph-indexer
COPY apps/indexer apps/indexer
COPY tsconfig.json ./
RUN pnpm --dir apps/indexer codegen && pnpm --dir apps/indexer typecheck
RUN pnpm --filter @olympusdao/treasury-subgraph-indexer deploy --prod /deploy

FROM base AS runtime
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx
COPY --from=build --chown=node:node /deploy /app/apps/indexer
COPY --from=build --chown=node:node /app/apps/indexer/.envio /app/apps/indexer/.envio
ENV NODE_ENV=production
# Envio treats these documented development defaults as required in production.
ENV HASURA_GRAPHQL_ROLE=admin
ENV ENVIO_THROTTLE_CHAIN_METADATA_INTERVAL_MILLIS=500
ENV ENVIO_THROTTLE_PRUNE_STALE_DATA_INTERVAL_MILLIS=30000
ENV PATH=/app/apps/indexer/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /app/apps/indexer
USER node
CMD ["tsx","src/start-envio.ts","start"]
