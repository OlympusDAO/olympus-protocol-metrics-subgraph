{
  "name": "@olympusdao/treasury-subgraph-client",
  "version": "3.0.0",
  "description": "Client for Olympus treasury metrics REST and legacy operations APIs.",
  "repository": {
    "type": "git",
    "url": "https://github.com/OlympusDAO/olympus-protocol-metrics-subgraph"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/apps/client/src/index.d.ts",
      "import": "./dist/apps/client/src/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "main": "./dist/apps/client/src/index.js",
  "types": "./dist/apps/client/src/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "pnpm run check:openapi && rm -rf dist && tsc -p tsconfig.build.json && pnpm run generate:openapi",
    "check:openapi": "tsx scripts/write-openapi.ts --check",
    "check:release": "tsx scripts/release-check.ts",
    "generate:openapi": "tsx scripts/write-openapi.ts",
    "prepack": "pnpm run build",
    "pack:dry-run": "pnpm run build && npm pack --dry-run --ignore-scripts --cache /tmp/olympus-treasury-subgraph-npm-cache",
    "prepublishOnly": "pnpm run check:release",
    "pretest": "pnpm run check:openapi",
    "test": "vitest run tests"
  }
}
