{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "on"
      }
    }
  },
  "files": {
    "includes": [
      "scripts/validate.mjs",
      "scripts/railway-release.cjs",
      "config/*.json",
      ".github/**",
      ".railway/**",
      "apps/**",
      "packages/**",
      "tests/**",
      "*.json",
      "*.jsonc",
      "*.yaml",
      "*.yml",
      "!**/.envio",
      "!**/.pnpm-store",
      "!**/build",
      "!**/coverage",
      "!**/dist",
      "!**/generated",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "useErrorMessage": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**/tests/**/*.test.ts",
        "apps/indexer-monitor/test/**/*.test.mjs",
        "packages/**/tests/**/*.test.ts",
        "tests/**/*.test.{ts,mjs}"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "on"
          }
        }
      },
      "includes": [
        "**/*.{json,jsonc}",
        "!**/package.json",
        "!docs/performance/**",
        "!apps/client/openapi.json"
      ]
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
