FROM node:24.22.3-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS base

ENV CI=true
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/corepack
ENV PATH=/pnpm:$PATH

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends --only-upgrade apt libapt-pkg6.0 libgcrypt20 libgnutls30 libpcre2-8-0 perl-base \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS build
RUN mkdir -p /corepack /pnpm && corepack enable && corepack prepare pnpm@11.28.13 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/indexer/package.json apps/indexer/package.json
COPY apps/metrics-api/package.json apps/metrics-api/package.json
COPY apps/metrics-publisher/package.json apps/metrics-publisher/package.json
COPY apps/client/package.json apps/client/package.json
RUN pnpm install --frozen-lockfile --filter @olympusdao/treasury-subgraph --filter @olympusdao/treasury-subgraph-metrics-api
COPY apps/metrics-api/src apps/metrics-api/src
COPY apps/metrics-api/tsconfig.build.json apps/metrics-api/tsconfig.build.json
COPY packages/metrics-artifacts/src packages/metrics-artifacts/src
COPY tsconfig.json ./
RUN pnpm --dir apps/metrics-api build
RUN pnpm --filter @olympusdao/treasury-subgraph-metrics-api deploy --prod /deploy

FROM base AS runtime
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx
COPY --from=build --chown=node:node /deploy /app
ENV NODE_ENV=production
WORKDIR /app
USER node
EXPOSE 3000
CMD ["node","dist/apps/metrics-api/src/cli.js"]
